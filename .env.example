# ===== OKX Scalper Bot — salin file ini menjadi .env lalu isi credential =====

# OKX_MODE: "demo" (default bila kosong) atau "live".
# LIVE MENGIRIM ORDER SUNGGUHAN — uji demo dulu.
OKX_MODE=demo

# --- Demo trading (dipakai saat OKX_MODE=demo) ---
# Ambil dari OKX -> Account -> API -> Demo Trading.
OKX_DEMO_API_KEY=isi_api_key_demo
OKX_DEMO_SECRET_KEY=isi_secret_key_demo
OKX_DEMO_PASSPHRASE=isi_passphrase_demo

# --- Live trading (dipakai saat OKX_MODE=live) ---
# Gunakan dengan sangat hati-hati. Izin trade-saja, tanpa withdrawal.
OKX_API_KEY=isi_api_key_live
OKX_SECRET_KEY=isi_secret_key_live
OKX_PASSPHRASE=isi_passphrase_live